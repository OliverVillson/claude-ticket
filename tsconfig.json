{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun-types"
    ],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "react-devtools-core": [
        "./src/stubs/react-devtools-core.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "scripts"
  ]
}
