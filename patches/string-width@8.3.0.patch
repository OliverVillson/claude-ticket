+// candidate never touches it. Every RGI emoji contains an Extended_Pictographic character, a
+// Regional Indicator or the keycap mark U+20E3; a lone BMP code unit is RGI exactly when it has
+// Emoji_Presentation.
+const emojiCandidateRegex = /[\p{Extended_Pictographic}\u{1F1E6}-\u{1F1FF}\u20E3]/u;
+const emojiPresentationRegex = /\p{Emoji_Presentation}/u;
