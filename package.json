{
  "name": "claude-ticket",
  "version": "0.1.0",
  "description": "A fast ticket queue for Claude Code agents: projects, tickets, an orchestrator that runs them, and a Claude-Code-style TUI.",
  "type": "module",
  "bin": {
    "ticket": "./src/index.ts"
  },
  "scripts": {
    "ticket": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build --compile --minify --splitting src/index.ts --outfile dist/ticket",
    "link": "bun link"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "patchedDependencies": {
    "string-width@8.3.0": "patches/string-width@8.3.0.patch"
  }
}
